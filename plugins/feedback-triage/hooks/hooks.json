{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*create_pull_request.*|mcp__.*[Ss]lack.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
